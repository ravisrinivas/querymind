# Database (defaults to the seeded SQLite file)
# DATABASE_URL=sqlite:///data/ecommerce.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/shop

# LLM providers (set whichever you use; with none set, the offline baseline is used)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Only set to 1 if you deliberately want write statements to be executable
# QUERYMIND_ALLOW_WRITES=0

# CORS origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000
